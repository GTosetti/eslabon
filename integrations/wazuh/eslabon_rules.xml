<!--
  eslabon: reglas de Wazuh (rango de IDs reservado: 100100-100199)
  ESTADO: VALIDADAS contra un wazuh-manager 4.14.7 real (lab, 2026-09-28): carga OK,
  configuración OK y las 11 reglas probadas con logtest. Ver docs/validacion-wazuh.md.
  F8: 100161 y 100170 (nuevas) y el cambio de 100160 (exige completo=true), validados en el
  mismo manager con logtest y de punta a punta con el agente.

  Instalar en: /var/ossec/etc/rules/eslabon_rules.xml   (o añadir a local_rules.xml)

  Niveles (escala de Wazuh 0-15):
    3  informativo / baja         5  media
    8  alta                       10 sospechoso alto (posible compromiso)
    12 vulnerabilidad crítica     14 paquete malicioso confirmado
-->
<group name="eslabon,supply_chain,">

  <!-- 100100: base. Cualquier evento de eslabon: el agente lee el fichero JSON Lines con
       <log_format>json</log_format> y Wazuh lo decodifica con su decoder "json" incorporado.
       (No hay vía por syslog: su regla usaba un decoder propio que, si no estaba instalado,
       hacía que el manager rechazara el fichero entero. Validado en el lab, ver README.) -->
  <!-- P1 (revisión de valores inseguros por defecto): solo eventos leídos de un fichero que
       termine en "eventos.jsonl". Sin esto, cualquier otra fuente JSON que llegue al manager
       (logs de una aplicación, eve.json...) con un campo eslabon.evento podría fabricar una
       alerta de nivel 14. En sregex (el tipo por defecto), "." es literal y "$" es "termina en". -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <location>eventos.jsonl$</location>
    <field name="eslabon.evento">\.+</field>
    <description>eslabon: evento de análisis de supply chain</description>
  </rule>

  <!-- Paquete malicioso confirmado por un aviso publicado o por el registro -->
  <rule id="100110" level="14">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^malicioso$</field>
    <description>eslabon: paquete MALICIOSO $(eslabon.ecosistema)/$(eslabon.paquete)@$(eslabon.paquete_version) ($(eslabon.id), fuentes: $(eslabon.fuentes))</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
    <group>malware,supply_chain_compromise,</group>
  </rule>

  <!-- Señales débiles correlacionadas: posible compromiso aún no confirmado -->
  <rule id="100120" level="10">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^sospechoso$</field>
    <field name="eslabon.severidad">^alta$|^critica$</field>
    <description>eslabon: paquete sospechoso (confianza alta) $(eslabon.paquete)@$(eslabon.paquete_version), confianza $(eslabon.confianza)</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
    <group>supply_chain_compromise,</group>
  </rule>

  <rule id="100121" level="7">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^sospechoso$</field>
    <field name="eslabon.severidad">^media$</field>
    <description>eslabon: paquete sospechoso $(eslabon.paquete)@$(eslabon.paquete_version), confianza $(eslabon.confianza)</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
  </rule>

  <rule id="100122" level="3">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^sospechoso$</field>
    <field name="eslabon.severidad">^baja$|^info$</field>
    <description>eslabon: señal débil en $(eslabon.paquete)@$(eslabon.paquete_version)</description>
  </rule>

  <!-- Repositorio de origen débil (compromiso antes de publicar) -->
  <rule id="100130" level="5">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^riesgo_origen$</field>
    <description>eslabon: riesgo en el repositorio de origen de $(eslabon.paquete)</description>
    <mitre>
      <id>T1195.002</id>
    </mitre>
  </rule>

  <!-- Vulnerabilidades conocidas (CVE/GHSA/PYSEC) -->
  <rule id="100140" level="12">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^vuln$</field>
    <field name="eslabon.severidad">^critica$</field>
    <description>eslabon: vulnerabilidad CRÍTICA $(eslabon.id) en $(eslabon.paquete)@$(eslabon.paquete_version)</description>
    <group>vulnerability,</group>
  </rule>

  <rule id="100141" level="8">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^vuln$</field>
    <field name="eslabon.severidad">^alta$</field>
    <description>eslabon: vulnerabilidad alta $(eslabon.id) en $(eslabon.paquete)@$(eslabon.paquete_version)</description>
    <group>vulnerability,</group>
  </rule>

  <rule id="100142" level="5">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^vuln$</field>
    <field name="eslabon.severidad">^media$</field>
    <description>eslabon: vulnerabilidad media $(eslabon.id) en $(eslabon.paquete)@$(eslabon.paquete_version)</description>
    <group>vulnerability,</group>
  </rule>

  <rule id="100143" level="3">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^hallazgo$</field>
    <field name="eslabon.tipo">^vuln$</field>
    <field name="eslabon.severidad">^baja$|^info$</field>
    <description>eslabon: vulnerabilidad baja $(eslabon.id) en $(eslabon.paquete)@$(eslabon.paquete_version)</description>
    <group>vulnerability,</group>
  </rule>

  <!-- Visibilidad reducida: una fuente no se pudo consultar -->
  <rule id="100150" level="4">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^fuente_omitida$</field>
    <description>eslabon: fuente omitida $(eslabon.fuente): el escaneo tiene visibilidad reducida</description>
  </rule>

  <!-- Resumen del escaneo (sin alerta, sirve para auditoría y paneles) -->
  <rule id="100160" level="2">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^resumen$</field>
    <field name="eslabon.completo">^true$</field>
    <description>eslabon: escaneo de $(eslabon.objetivo) completado</description>
  </rule>

  <!-- Escaneo INCOMPLETO: sin inventario, sin OSV o sin una fuente requerida (código 3).
       Cero hallazgos aquí no es "limpio": hay que saber que no se miró. -->
  <rule id="100161" level="6">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^resumen$</field>
    <field name="eslabon.completo">^false$</field>
    <description>eslabon: escaneo INCOMPLETO de $(eslabon.objetivo) (fuentes omitidas: $(eslabon.fuentes_omitidas))</description>
  </rule>

  <!-- El escaneo programado no pudo ejecutarse (lo escribe scripts/escaneo_programado.ps1).
       Sin este evento, un fallo del propio escaneo sería silencio en el SIEM. -->
  <rule id="100170" level="7">
    <if_sid>100100</if_sid>
    <field name="eslabon.evento">^error_programado$</field>
    <description>eslabon: el escaneo programado de $(eslabon.objetivo) falló (código $(eslabon.codigo)): $(eslabon.motivo)</description>
  </rule>

</group>
